<Window x:Class="PublishHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="班级工作台发布助手"
        Height="680" Width="980"
        MinHeight="600" MinWidth="860"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border CornerRadius="14" Background="#F5F6FA" BorderBrush="#E0E3EE" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="3" Direction="270" Opacity="0.28" Color="#1B2A6B"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======================= 侧边栏 ======================= -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 品牌区 -->
                    <StackPanel Grid.Row="0" Margin="20,22,16,18" MouseLeftButtonDown="SidebarHeader_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="12" Background="#FFFFFF" Opacity="0.14" VerticalAlignment="Center">
                                <TextBlock Text="班" FontSize="20" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="班级工作台" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="发布助手" FontSize="11" Foreground="#AAB4D8" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- 导航 -->
                    <StackPanel Grid.Row="1" Margin="14,6,14,0">
                        <TextBlock Text="发布" FontSize="11" Foreground="#8A96C9" Margin="8,4,0,8" FontWeight="SemiBold"/>
                        <RadioButton x:Name="NavRelease" GroupName="nav" IsChecked="True" Style="{StaticResource NavItemStyle}"
                                     Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2 L20,5 V11 C20,16 16,19 12,20 C8,19 4,16 4,11 V5 Z" Stroke="#FFFFFF" StrokeThickness="1.6"
                                      Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="发布新版本" FontSize="13" Margin="12,0,0,0" Foreground="White"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavDocs" GroupName="nav" Style="{StaticResource NavItemStyle}" Margin="0,4,0,0"
                                     Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M6,2 H16 L20,6 V22 H6 Z M14,2 V7 H20 M9,13 H16 M9,17 H16" Stroke="#FFFFFF" StrokeThickness="1.6"
                                      Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="同步协议文档" FontSize="13" Margin="12,0,0,0" Foreground="White"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 底部状态 -->
                    <Border Grid.Row="2" Margin="14,0,14,18" Padding="12,10" CornerRadius="10" Background="#FFFFFF" Opacity="0.09">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="EnvDot" Width="8" Height="8" Fill="#FFD45A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="EnvStatusText" Text="正在检查环境…" FontSize="11" Foreground="#DDE2F5" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="GitInfoText" Text="" FontSize="10.5" Foreground="#AAB4D8" Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ======================= 内容区 ======================= -->
            <Grid Grid.Column="1" Background="{StaticResource PageBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部标题栏（可拖拽） -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitle" Text="发布新版本" FontSize="14.5" FontWeight="SemiBold"
                               Margin="22,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="MinBtn" Style="{StaticResource WindowBtnStyle}" Content="&#xE921;" Click="MinBtn_Click"/>
                        <Button x:Name="CloseBtn" Style="{StaticResource WindowBtnStyle}" Content="&#xE8BB;" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ============ 视图 1：发布新版本 ============ -->
                <ScrollViewer x:Name="ReleaseView" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="22,8,22,20">
                    <StackPanel>
                        <!-- 版本信息 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,4,0,14">
                            <StackPanel>
                                <TextBlock Text="版本信息" FontSize="13.5" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="当前版本" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Border Background="#F0F2F9" CornerRadius="8" Padding="12,6" Margin="0,6,0,0">
                                            <TextBlock x:Name="CurrentVersionText" Text="—" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="24,0,0,0">
                                        <TextBlock Text="新版本号" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBox x:Name="NewVersionBox" Style="{StaticResource InputBox}" Width="150"
                                                     Text="" FontSize="14" FontWeight="Bold"/>
                                            <Button x:Name="PlusPatchBtn" Content="+1" Style="{StaticResource GhostButton}"
                                                    Margin="8,0,0,0" Height="33" Click="PlusVersion_Click" Tag="patch"/>
                                            <Button x:Name="PlusMinorBtn" Content="+0.1" Style="{StaticResource GhostButton}"
                                                    Margin="6,0,0,0" Height="33" Click="PlusVersion_Click" Tag="minor"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 发布说明 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="发布说明" FontSize="13.5" FontWeight="Bold"/>
                                <TextBlock Text="将展示在 GitHub Release 与关于面板，建议写清本次改动要点" FontSize="11"
                                           Foreground="{StaticResource TextFaintBrush}" Margin="0,3,0,0"/>
                                <TextBox x:Name="ReleaseNotesBox" Height="92" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         Margin="0,12,0,0" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                        </Border>

                        <!-- 发布方式 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="发布方式" FontSize="13.5" FontWeight="Bold"/>
                                <RadioButton x:Name="PublishOnline" GroupName="mode" IsChecked="True" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="发布到 GitHub（生成自动更新）" FontSize="13"/>
                                        <Border Background="#EAF2ED" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="推荐" FontSize="10.5" Foreground="{StaticResource SuccessBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                                <TextBlock Text="构建 NSIS 安装包并上传到 GitHub Releases，应用即可在线自动升级" FontSize="11"
                                           Foreground="{StaticResource TextFaintBrush}" Margin="0,3,0,0"/>
                                <RadioButton x:Name="PublishLocal" GroupName="mode" Margin="0,10,0,0">
                                    <TextBlock Text="仅本地构建（不发布，用于自测）" FontSize="13"/>
                                </RadioButton>

                                <StackPanel x:Name="TokenRow" Margin="0,12,0,0">
                                    <TextBlock Text="GitHub Token（发布需要，留空则使用系统环境变量）" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <PasswordBox x:Name="TokenBox" Margin="0,6,0,0" Height="34" FontSize="12"
                                                 Background="#FFFFFF" BorderBrush="#D8DBE6" BorderThickness="1"/>
                                    <TextBlock x:Name="TokenHint" Text="未检测到系统 GH_TOKEN，发布前请粘贴 Token" FontSize="10.5"
                                               Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 发布按钮 + 日志 -->
                        <Button x:Name="ReleaseButton" Style="{StaticResource PrimaryButton}" Click="ReleaseButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ReleaseButtonText" Text="开 始 发 布" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <Border Background="#1F2437" CornerRadius="12" Margin="0,16,0,0" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                    <Ellipse Width="8" Height="8" Fill="#4A5DB0" VerticalAlignment="Center"/>
                                    <TextBlock Text="运行日志" FontSize="12" Foreground="#C7CEE6" Margin="8,0,0,0"/>
                                </StackPanel>
                                <RichTextBox x:Name="ReleaseLog" IsReadOnly="True" Height="150" BorderThickness="0"
                                             Background="Transparent" Foreground="#B7BED9" FontFamily="Consolas"
                                             FontSize="12" VerticalScrollBarVisibility="Auto">
                                    <RichTextBox.Document>
                                        <FlowDocument PagePadding="0,0,0,0" LineHeight="18"/>
                                    </RichTextBox.Document>
                                </RichTextBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 视图 2：同步协议文档 ============ -->
                <ScrollViewer x:Name="DocsView" Grid.Row="1" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="22,8,22,20">
                    <StackPanel>
                        <!-- 目标路径 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,4,0,14">
                            <StackPanel>
                                <TextBlock Text="目标路径" FontSize="13.5" FontWeight="Bold"/>
                                <TextBlock Text="协议文件目录（主仓库根目录）与网站仓库工作区（classworkbench-site）已自动探测" FontSize="11"
                                           Foreground="{StaticResource TextFaintBrush}" Margin="0,3,0,0"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="协议文件目录" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#F5F6FA" CornerRadius="8" Padding="10,7" Margin="0,0,10,0">
                                        <TextBlock x:Name="SrcPathText" Text="—" FontSize="11.5" FontFamily="Consolas"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Grid.Column="2" x:Name="PickSrcBtn" Content="更改" Style="{StaticResource GhostButton}"
                                            Click="PickSrc_Click"/>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="网站仓库目录" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#F5F6FA" CornerRadius="8" Padding="10,7" Margin="0,0,10,0">
                                        <TextBlock x:Name="SitePathText" Text="—" FontSize="11.5" FontFamily="Consolas"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Grid.Column="2" x:Name="PickSiteBtn" Content="更改" Style="{StaticResource GhostButton}"
                                            Click="PickSite_Click"/>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="SrcDot" Width="8" Height="8" Fill="#9AA3BD" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SrcStatusText" Text="检查中…" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="7,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Ellipse x:Name="SiteDot" Width="8" Height="8" Fill="#9AA3BD" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SiteStatusText" Text="检查中…" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="7,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 文档选择 -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="推送文档" FontSize="13.5" FontWeight="Bold"/>
                                <TextBlock Text="未勾选的文档保持线上原样，不会被删除" FontSize="11" Foreground="{StaticResource TextFaintBrush}"
                                           Margin="0,3,0,0"/>
                                <WrapPanel x:Name="DocList" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="PushDocsButton" Style="{StaticResource PrimaryButton}" Click="PushDocs_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PushDocsButtonText" Text="一 键 推 送" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <Border Background="#1F2437" CornerRadius="12" Margin="0,16,0,0" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                    <Ellipse Width="8" Height="8" Fill="#4A5DB0" VerticalAlignment="Center"/>
                                    <TextBlock Text="运行日志" FontSize="12" Foreground="#C7CEE6" Margin="8,0,0,0"/>
                                </StackPanel>
                                <RichTextBox x:Name="DocsLog" IsReadOnly="True" Height="170" BorderThickness="0"
                                             Background="Transparent" Foreground="#B7BED9" FontFamily="Consolas"
                                             FontSize="12" VerticalScrollBarVisibility="Auto">
                                    <RichTextBox.Document>
                                        <FlowDocument PagePadding="0,0,0,0" LineHeight="18"/>
                                    </RichTextBox.Document>
                                </RichTextBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
