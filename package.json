{
  "name": "classworkbench",
  "version": "1.0.0",
  "description": "\u73ED\u7EA7\u5DE5\u4F5C\u53F0 \u2014\u2014 \u9762\u5411\u73ED\u7EA7\u6559\u5B66\u573A\u666F\u7684\u684C\u9762\u5E94\u7528\uFF1A\u4F5C\u4E1A\u7BA1\u7406\u3001\u5B66\u79D1\u914D\u8272\u3001\u5929\u6C14\u9884\u8B66\u3001QQ \u901A\u77E5\u6355\u83B7\u3001\u753B\u4E2D\u753B\u6D6E\u7A97\u3002\u672C\u5730\u4F18\u5148\uFF0CMIT \u5F00\u6E90\u3002",
  "author": "ClassWorkBench Authors",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "check:emoji": "node tools/check-emoji.mjs"
  },
  "build": {
    "appId": "com.classworkbench.app",
    "productName": "\u73ED\u7EA7\u5DE5\u4F5C\u53F0",
    "executableName": "ClassWorkBench",
    "files": [
      "**/*",
      "!sidecar/**/*",
      "!dist/**/*",
      "!.workbuddy/**/*",
      "!docs/**/*",
      "!test.bat",
      "!promo/**/*"
    ],
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "cwb-uninstaller.nsh"
    },
    "extraResources": [
      {
        "from": "sidecar/qq-listener/bin/Release/net8.0-windows10.0.19041.0/win-x64/publish",
        "to": "sidecar",
        "filter": [
          "qq-listener.exe"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ClassWorkBench",
        "repo": "classworkbench"
      }
    ]
  },
  "dependencies": {
    "atomically": "^2.0.3",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
